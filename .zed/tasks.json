[
  {
    "label": "Build: Native",
    "command": "./build.sh native",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "shell": "system",
    "tags": ["build", "native"]
  },
  {
    "label": "Build: Managed",
    "command": "./build.sh managed",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "shell": "system",
    "tags": ["build", "csharp"]
  },
  {
    "label": "Build: HyprNetShell",
    "command": "./build.sh build",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "shell": "system",
    "tags": ["build"]
  },
  {
    "label": "Run: HyprNetShell",
    "command": "./build.sh run",
